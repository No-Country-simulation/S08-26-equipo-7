# Variables usadas por docker-compose.yml.
# Copiar este archivo a la RAÍZ del repo como .env (junto a docker-compose.yml) y ajustar los valores.
# ADMIN_PASSWORD_HASH y JWT_SECRET son OBLIGATORIAS: sin ellas `docker compose up` falla a propósito.
# Nota: en ADMIN_PASSWORD_HASH los "$" van escapados como "$$" porque Docker Compose interpeta "$".

# Postgres (puerto del HOST; el contenedor siempre usa 5432 internamente)
DB_PORT=5433
DB_PASSWORD=serviceflow_dev

# Credenciales/secretos que la API necesita para arrancar (obligatorias)
ADMIN_PASSWORD_HASH=$$2a$$10$$Ges6Ky4QenZYaULDVYVyUer3CzOGjtjzlC5RV7rbYxSCD49QedRme
JWT_SECRET=clave-super-secreta-serviceflow-2026-cambiar-en-produccion-muy-larga
JWT_EXPIRATION_MS=86400000